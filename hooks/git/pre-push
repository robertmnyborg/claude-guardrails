#!/usr/bin/env bash
# Global pre-push gate (core.hooksPath). Blocks a push when the outgoing commits look like they hold a secret.
# Bypass for a confirmed false positive: add "secret-scan:allow" to the line, or SECRET_SCAN_SKIP=1 git push (human only).
set -uo pipefail
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH
SCAN="${SECRET_SCAN:-$(command -v secret-scan || echo "$HOME/bin/secret-scan")}"
remote="$1"
zero=0000000000000000000000000000000000000000
input=$(cat)

if [ "${SECRET_SCAN_SKIP:-}" != "1" ]; then
  command -v gitleaks >/dev/null || { echo "pre-push: gitleaks missing (brew install gitleaks). Push blocked." >&2; exit 1; }
  fail=0
  while read -r lref lsha rref rsha; do
    [ -z "${lsha:-}" ] || [ "$lsha" = "$zero" ] && continue
    if [ "$rsha" = "$zero" ] || ! git cat-file -e "$rsha" 2>/dev/null; then
      range=("$lsha" --not "--remotes=$remote")
    else
      range=("$rsha..$lsha")
    fi
    gitleaks git --redact --no-banner --log-level warn --log-opts="${range[*]}" || fail=1
    # Every outgoing commit, so a secret added and then deleted still blocks. Reports names, never values.
    for c in $(git rev-list "${range[@]}"); do
      while IFS= read -r f; do
        [ -z "$f" ] && continue
        if ! git show --format= "$c" -- "$f" | { grep -E '^\+[^+]' || true; } | "$SCAN" --stdin 2>/dev/null; then
          echo "pre-push: possible secret in $f (commit ${c:0:7}, $lref)" >&2; fail=1
        fi
      done < <(git show --format= --name-only --diff-filter=AM "$c")
    done
  done <<<"$input"
  if [ "$fail" -ne 0 ]; then
    echo "pre-push: push BLOCKED. Remove the secret from the commits (rewrite them), then push again." >&2
    exit 1
  fi
  echo "pre-push: secret scan passed (gitleaks rules + named-credential, URL-password, private-key checks). Unnamed random strings are not covered." >&2
fi

# Chain to the repo's own pre-push hook, which core.hooksPath would otherwise hide.
local_hook="$(git rev-parse --git-common-dir)/hooks/pre-push"
[ -z "${SECRET_SCAN_NO_CHAIN:-}" ] && [ -x "$local_hook" ] && exec "$local_hook" "$@" <<<"$input"
exit 0
