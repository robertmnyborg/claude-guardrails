#!/usr/bin/env bash
# Deterministic secret check shared by the git pre-push hook and the Claude command guard.
#   secret-scan <dir>   gitleaks + extra patterns over a folder; prints file:line only
#   secret-scan --stdin extra patterns over text on stdin; prints line numbers only
# Exit 0 = nothing found, 1 = possible secret, 2 = scanner missing. Never prints matched values.
# Coverage: gitleaks default rules, URL userinfo passwords, PEM private keys, and any 8+ char value
# assigned to a password/secret/token/api_key/private_key/credential name. It cannot see secrets
# with no telltale name or format (a bare random string in prose).
set -euo pipefail
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH

# Placeholders pass: $VAR, <...>, {...}, ***, ..., your-*, paths, and quoted prose with spaces.
# Code that READS a credential passes too: os.environ[...], os.getenv(, process.env., and type
# annotations such as list[set] (2026-09-19: both were denied as literal credentials).
# A line marked secret-scan:allow passes; only a human adds that marker.
# 2026-09-26: an UPPER_CONST value must be case-sensitive with an underscore. Under /i the old
# [A-Z][A-Z0-9_]{3,} passed ANY unquoted value at end of line (PASSWORD=Hunter2..., token=ghp_...).
# Regex redactions (sed 's/PASSWORD=.*/.../', (token=)[^&]+) and escaped os\.environ pass.
# 2026-10-03: a value starting with any [ (regex class [0-9a-f]{128}, array literal), an escaped sed
# group \(TOKEN=\), and URL userinfo on localhost/127.0.0.1 pass (3 of 5 blocks that week were these).
# 2026-10-10: an @NAME reference (env-manifest syntax, GITHUB_TOKEN=@GITHUB_TOKEN) passes (2 of 4 blocks).
# After ANY edit here: prove-tests 'bash tests/secret-scan-cases/run.sh' (clean lines pass, planted secrets fail).
PERL='
  BEGIN { $ph = qr#(?![\$<{/~)\[\]]|\*\*\*|\@(?-i:[A-Z][A-Z0-9_]*)(?:[^A-Za-z0-9_]|$)|\.[*+]|\\[SsWwd()]|your[-_]|os\\?\.environ\b|os\.getenv\(|process\.env\.|self\.[A-Za-z_]|(?-i:[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+)(?:[,)\s`.;:\x27\]]|$)|(?:list|dict|set|tuple|str|int|bool)[\[,)]|[^"\x27\s]*\.\.\.|[^"\x27\n]* [^"\x27\n]*\x27|[^"\x27\n]* [^"\x27\n]*")#i }
  # max_tokens / num_tokens are LLM length settings, not credentials (2026-09-22: blocked a clean push).
  # Anchor the name at a word start, or the lookahead is skipped by matching from "_tokens".
  $name = qr{(?<![A-Za-z0-9_])(?!max_|num_|output_)[A-Za-z0-9_]*(?:pass(?:word|wd)?|secret|token|api_?key|private_?key|credential)s?(?![A-Za-z])}i;
  if (!/secret-scan:allow/ && (
      /$name\\?["\x27]?\s*[:=]\s*(\\?["\x27])$ph(?:(?!\1).){8,}?\1/ || /$name=$ph[^\s"\x27]{8,}/
      || m#[a-z]+://[^/:@\s]+:(?!\$|<|\*\*\*)[^@\s<]{3,}@(?!(?:localhost|127\.0\.0\.1)[:\/\s"\x27]|(?:localhost|127\.0\.0\.1)$)# || /-----BEGIN [A-Z ]*PRIVATE KEY-----/)) {
    print(($ARGV eq "-" ? "" : "$ARGV:") . "$.\n");
  }
  close ARGV if eof;'

if [ "${1:-}" = "--stdin" ]; then
  hits=$(perl -ne "$PERL" -)
  [ -z "$hits" ] && exit 0
  printf 'possible secret on line %s\n' $hits >&2
  exit 1
fi

dir="${1:?usage: secret-scan <dir> | secret-scan --stdin}"
command -v gitleaks >/dev/null || { echo "gitleaks missing: brew install gitleaks" >&2; exit 2; }
status=0
gitleaks dir "$dir" --redact --no-banner --log-level warn || status=1
hits=$(find "$dir" -type f -not -path '*/.git/*' -print0 | xargs -0 perl -ne "$PERL")
if [ -n "$hits" ]; then
  echo "$hits"
  echo "credential check found possible secrets at the file:line locations above" >&2
  status=1
fi
[ "$status" -eq 0 ] && echo "secret scan passed: $dir (gitleaks rules + named-credential, URL-password and private-key checks)"
exit "$status"
